# PINNACLE API Configuration
PORT=3001
NODE_ENV=development

# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=u701509674_Mant_piic

# Security
JWT_SECRET=super-secret-archon-key-2026
DB_ENCRYPTION_KEY=32_character_long_secret_key_here!
ADMIN_BYPASS_ID=0

# Correo transaccional (FC187) — SOLO en el entorno del servidor (panel de Hostinger), nunca valores reales aqui.
# Sin SMTP_HOST/PORT/USER/PASS completos el correo queda DESACTIVADO (el API arranca igual, con una advertencia en el log).
# SMTP_USER es tambien el remitente (From). Puerto 465 = TLS implicito; otro puerto = STARTTLS obligatorio.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# SMTP_FROM_NAME=Archon ERP
# SMTP_REPLY_TO=

# Mapa de Rastreo (FC207) — SOLO en el entorno del servidor, nunca la clave real aqui ni en variables VITE_.
# Plantilla https con {z}, {x} y {y}; la clave del proveedor va dentro. Vacia = mapa en blanco (502 TILE_UPSTREAM_NOT_CONFIGURED).
# Ejemplo de forma: https://tiles.stadiamaps.com/tiles/alidade_smooth_dark/{z}/{x}/{y}.png?api_key=<clave>
MAP_TILES_UPSTREAM_URL=
