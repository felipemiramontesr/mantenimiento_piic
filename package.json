{
  "name": "mantenimiento-piic",
  "version": "78.103.134",
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "Automotive Maintenance Management System - PIIC Premium",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "npm run build --workspace=@mantenimiento/api",
    "start": "npm run build --workspace=@mantenimiento/api && node apps/api/dist/index.js",
    "test": "bun run --filter '*' test",
    "test:e2e": "bunx playwright test",
    "test:e2e:local": "bunx playwright test --config=playwright.local.config.ts",
    "test:e2e:ui": "bunx playwright test --ui",
    "lint": "bun run --filter '*' lint",
    "db:validate": "bun packages/database/scripts/validate-sql.ts",
    "protocol:verify": "bun scripts/verifyProtocolL.ts",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^65.0.1",
    "globals": "^17.7.0",
    "husky": "^8.0.0",
    "lint-staged": "^13.0.0",
    "msw": "^2.13.4",
    "prettier": "^2.8.0",
    "tsx": "^4.19.1",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,html,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0"
  },
  "overrides": {
    "yaml": "^2.9.0",
    "micromatch": "^4.0.8",
    "brace-expansion@1": "^1.1.18",
    "brace-expansion@2": "^2.1.2",
    "brace-expansion@5": "^5.0.8",
    "fast-uri": "^3.1.3",
    "find-my-way": "^9.7.0",
    "postcss": "^8.5.23",
    "filelist": "^2.0.2",
    "nanoid": "^3.3.17"
  }
}
